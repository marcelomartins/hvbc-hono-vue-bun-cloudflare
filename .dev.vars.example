# Local configuration for both `bun run dev` (workerd) and `bun run start` (Bun).
ENVIRONMENT=local
APP_ORIGIN=http://localhost
SESSION_SECRET=

# Bun server only. Relative paths are resolved from the project root.
# PORT=3000
# 0.0.0.0 listens on every network interface.
# LISTEN_HOST=127.0.0.1
# DATABASE_PATH=.data/app.sqlite

# Optional delivery for the email a project sends; the framework sends none. "console"
# prints messages in the terminal, "ses" delivers through Amazon SES, "cloudflare"
# needs the EMAIL binding in wrangler.jsonc and so works only on Workers, and "none"
# drops them. Both providers need EMAIL_FROM, an address or "Name <address>".
EMAIL_DRIVER=console
EMAIL_FROM=
SES_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional Cloudflare Turnstile. Both values must be set together.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
