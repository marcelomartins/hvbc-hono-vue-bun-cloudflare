# Local configuration for both `bun run dev` (workerd) and `bun run start` (Bun).
ENVIRONMENT=local
APP_HOST=localhost
APP_ORIGIN=http://localhost
SESSION_SECRET=

# Optional email delivery. Use "console" locally to print messages in the terminal,
# "ses" to deliver through Amazon SES, or "none" to disable it.
EMAIL_DRIVER=console
SES_REGION=
SES_FROM=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional Cloudflare Turnstile. Both values must be set together.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
