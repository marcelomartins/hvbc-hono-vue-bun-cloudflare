{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hvbc",
  "main": "./server/src/cloudflare.ts",
  // Keep at or below the date supported by the workerd bundled with
  // @cloudflare/vitest-plugin, so integration tests run with production semantics.
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    }
  },
  "assets": {
    "directory": "./dist/web-vue",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/",
      "/auth",
      "/auth/*",
      "/api",
      "/api/*",
      "/health",
      "/health/*",
      "/app",
      "/app/*",
      "/index-spa",
      "/index-spa/*",
      "/index-spa.html",
      "!/assets/*"
    ]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "APP_ORIGIN": "https://hvbc.invalid",
    // Optional delivery for the email a project sends; the framework sends none.
    // "none" (default), "console" (local only), "cloudflare" (the EMAIL binding below)
    // or "ses" (SES_REGION and the AWS secrets). Both providers need EMAIL_FROM, an
    // address or "Name <address>".
    "EMAIL_DRIVER": "none",
    "EMAIL_FROM": "",
    "SES_REGION": "",
    // Optional Turnstile: set this together with the TURNSTILE_SECRET_KEY secret.
    "TURNSTILE_SITE_KEY": "",
    // Optional rate limiting of /auth/login and /auth/register: "true" also requires
    // the AUTH_RATE_LIMITER binding below to be uncommented.
    "AUTH_RATE_LIMIT": "false"
  },
  // "ratelimits": [
  //   {
  //     "name": "AUTH_RATE_LIMITER",
  //     "namespace_id": "1001",
  //     // At most 20 attempts per key every 60 seconds (period must be 10 or 60).
  //     "simple": { "limit": 20, "period": 60 }
  //   }
  // ],
  // Required by EMAIL_DRIVER=cloudflare. Sending to any recipient needs the Workers
  // Paid plan and the EMAIL_FROM domain onboarded to Cloudflare Email Service.
  // "send_email": [{ "name": "EMAIL" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hvbc",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./server/migrations"
    }
  ]
}
