{
  "name": "@bhvc/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cloudflare": "vite --mode cloudflare",
    "build": "vite-ssg build && bun scripts/write-static-files.ts && bun scripts/check-client-build.ts",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@bhvc/contracts": "workspace:*",
    "@unhead/vue": "^2.1.17",
    "vite-ssg": "^28.3.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@types/bun": "^1.4.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
